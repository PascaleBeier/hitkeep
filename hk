#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
go_version=$(awk '$1 == "go" { print $2; exit }' "$root/go.mod")
case $(uname -s) in
  Darwin)
    host_goos=darwin
    default_cache_root=${HOME}/Library/Caches
    ;;
  Linux)
    host_goos=linux
    default_cache_root=${XDG_CACHE_HOME:-"$HOME/.cache"}
    ;;
  *)
    echo "hk supports macOS and Linux development hosts" >&2
    exit 1
    ;;
esac
case $(uname -m) in
  arm64 | aarch64) host_goarch=arm64 ;;
  x86_64 | amd64) host_goarch=amd64 ;;
  *)
    echo "unsupported development architecture: $(uname -m)" >&2
    exit 1
    ;;
esac
state_root=${HK_STATE_DIR:-${default_cache_root}/hitkeep/hk}
cache_root=${HK_CACHE_DIR:-${state_root}/bin}
bootstrap_cache_root=${state_root}/bootstrap
bootstrap_mod_cache=${bootstrap_cache_root}/go-mod
bootstrap_build_cache=${bootstrap_cache_root}/go-build
mkdir -p "$cache_root" "$bootstrap_mod_cache" "$bootstrap_build_cache"

if command -v shasum >/dev/null 2>&1; then
  key=$(
    cd "$root"
    find cmd/hk internal/devtool -type f \( \( -name '*.go' ! -name '*_test.go' \) -o -name '*.json' \) -exec shasum -a 256 {} \;
    shasum -a 256 go.mod go.sum
  )
  key=$(printf '%s\n' "$key" | LC_ALL=C sort | shasum -a 256 | awk '{print $1}')
else
  key=$(
    cd "$root"
    find cmd/hk internal/devtool -type f \( \( -name '*.go' ! -name '*_test.go' \) -o -name '*.json' \) -exec sha256sum {} \;
    sha256sum go.mod go.sum
  )
  key=$(printf '%s\n' "$key" | LC_ALL=C sort | sha256sum | awk '{print $1}')
fi

binary="$cache_root/hk-$key"
if [ ! -x "$binary" ]; then
  lock="$binary.lock"
  attempts=0
  while ! mkdir "$lock" 2>/dev/null; do
    if [ -x "$binary" ]; then
      break
    fi
    attempts=$((attempts + 1))
    if [ "$attempts" -ge 600 ]; then
      echo "timed out waiting for another hk bootstrap" >&2
      exit 1
    fi
    sleep 0.1
  done
fi

if [ ! -x "$binary" ]; then
  temporary="$binary.tmp.$$"
  trap 'rm -f "$temporary"; rmdir "$lock" 2>/dev/null || true' EXIT HUP INT TERM
  if command -v go >/dev/null 2>&1 && [ "$(go env GOVERSION 2>/dev/null || true)" = "go$go_version" ]; then
    (cd "$root" && go build -trimpath -ldflags "-X main.version=dev-$key" -o "$temporary" ./cmd/hk)
  elif command -v docker >/dev/null 2>&1; then
    docker run --rm \
      --user "$(id -u):$(id -g)" \
      -e CGO_ENABLED=0 \
      -e HOME=/tmp/hk-home \
      -e GOMODCACHE=/cache/go-mod \
      -e GOCACHE=/cache/go-build \
      -e "GOOS=$host_goos" \
      -e "GOARCH=$host_goarch" \
      -v "$root:/src" \
      -v "$cache_root:/out" \
      -v "$bootstrap_mod_cache:/cache/go-mod" \
      -v "$bootstrap_build_cache:/cache/go-build" \
      -w /src \
      "golang:$go_version" \
      go build -trimpath -ldflags "-X main.version=dev-$key" -o "/out/$(basename "$temporary")" ./cmd/hk
  else
    echo "hk requires Docker for its first bootstrap when no cached developer binary or exact optional host Go $go_version is available" >&2
    exit 1
  fi
  chmod 755 "$temporary"
  mv "$temporary" "$binary"
  rmdir "$lock" 2>/dev/null || true
  trap - EXIT HUP INT TERM
fi

exec "$binary" "$@"
