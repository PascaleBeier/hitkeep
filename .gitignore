# Local build and runtime artifacts.
/tmp/
/hitkeep
/main
*.test
/hitkeep.db*
/*-local-*.png
/archive/
/public/*
!/public/embed.go
/data/

# Frontend test artifacts.
/frontend/dashboard/test-results/
/frontend/dashboard/playwright-report/

# Canonical contributor skills are versioned source, even with a global ignore.
!/.agents/
!/.agents/**

# Portable project MCP registrations override common global ignore rules.
!/.mcp.json
!/.codex/
!/.codex/config.toml
!/.gemini/
!/.gemini/settings.json
!/.vscode/
!/.vscode/mcp.json
!/.cursor/
/.cursor/*
!/.cursor/mcp.json
