{
    "name": "@hitkeep/dashboard",
    "license": "MIT",
    "version": "2.12.0",
    "packageManager": "npm@12.0.1",
    "scripts": {
        "ng": "ng",
        "start": "ng serve",
        "build": "ng build && npm run sync:public",
        "sync:public": "node scripts/sync-public.mjs",
        "transloco:optimize": "transloco-optimize dist/dashboard/browser/i18n",
        "build:tracker": "esbuild src/tracker/index.ts --bundle --minify --outfile=dist/dashboard/browser/hk.js && esbuild src/tracker/vitals.ts --bundle --minify --outfile=dist/dashboard/browser/hk-vitals.js",
        "build:tracker-package": "node scripts/build-tracker-package.mjs",
        "verify:tracker-package": "node scripts/verify-tracker-package.mjs",
        "build:prod": "ng build --configuration production && npm run transloco:optimize && npm run build:tracker && npm run sync:public",
        "watch": "ng build --watch --configuration development",
        "test": "ng test",
        "test:ci": "ng test --watch=false --no-progress",
        "i18n:check": "node scripts/check-i18n-locales.mjs",
        "e2e": "node scripts/run-e2e.mjs",
        "lint": "ng lint",
        "fmt": "oxfmt",
        "fmt:check": "oxfmt --check"
    },
    "private": true,
    "dependencies": {
        "@angular/animations": "^22.0.8",
        "@angular/cdk": "~22.0.6",
        "@angular/common": "^22.0.8",
        "@angular/compiler": "^22.0.8",
        "@angular/core": "^22.0.8",
        "@angular/forms": "^22.0.8",
        "@angular/platform-browser": "^22.0.8",
        "@angular/router": "^22.0.8",
        "@fontsource-variable/lexend": "^5.3.0",
        "@jsverse/transloco-locale": "^8.4.0",
        "@openng/optimus-ui": "^1.0.0-rc.1",
        "@scalar/api-reference": "^1.63.0",
        "@tailwindcss/postcss": "^4.3.3",
        "circle-flags": "^2.8.3",
        "echarts": "^6.1.0",
        "ng-number-flow": "0.2.0",
        "ngx-echarts": "^22.0.0",
        "number-flow": "0.6.2",
        "qr-code-styling": "^1.9.2",
        "rxjs": "~7.8.2",
        "tailwindcss": "^4.3.3",
        "tailwindcss-primeui": "^0.6.1",
        "tslib": "^2.8.1",
        "web-vitals": "^6.0.0",
        "@openng/icons": "^1.0.0",
        "@openng/optimus-ui-themes": "^1.0.0-rc.1"
    },
    "devDependencies": {
        "@angular-devkit/schematics": "^22.0.8",
        "@angular-eslint/builder": "^22.1.0",
        "@angular/build": "^22.0.8",
        "@angular/cli": "^22.0.8",
        "@angular/compiler-cli": "^22.0.8",
        "@eslint/js": "^10.0.1",
        "@jsverse/transloco": "^8.4.0",
        "@jsverse/transloco-optimize": "^8.4.0",
        "@playwright/test": "^1.61.1",
        "@types/jasmine": "~6.0.0",
        "@vitest/browser-playwright": "^4.1.10",
        "@vitest/coverage-v8": "^4.1.10",
        "angular-eslint": "22.1.0",
        "baseline-browser-mapping": "^2.11.1",
        "esbuild": "0.28.1",
        "eslint": "^10.7.0",
        "jasmine-core": "~6.3.0",
        "jsdom": "^29.1.1",
        "oxfmt": "^0.60.0",
        "playwright": "^1.61.1",
        "postcss": "^8.5.22",
        "typescript": "~6.0.3",
        "typescript-eslint": "8.65.0",
        "vitest": "^4.1.10"
    },
    "engines": {
        "node": "24.18.0",
        "npm": "12.0.1"
    },
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": "24.18.0",
            "onFail": "error"
        },
        "packageManager": {
            "name": "npm",
            "version": "12.0.1",
            "onFail": "error"
        }
    },
    "overrides": {
        "dompurify": "3.4.2",
        "@jsverse/transloco-optimize": {
            "glob": "^11.1.0"
        }
    },
    "packageExtensions": {
        "@jsverse/transloco-locale@8.4.0": {
            "dependencies": {
                "@jsverse/utils": "1.0.0-beta.5"
            }
        }
    },
    "allowScripts": {
        "@parcel/watcher@2.5.6": true,
        "esbuild@0.27.7": true,
        "esbuild@0.28.1": true,
        "fsevents@2.3.2": true,
        "fsevents@2.3.3": true,
        "lmdb@3.5.4": true,
        "msgpackr-extract@3.0.4": true,
        "vue-demi@0.14.10": true
    }
}
