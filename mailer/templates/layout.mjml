<mjml lang="{{ .Meta.Locale }}">
  <mj-head>
    <mj-title>{{ .Meta.Subject }}</mj-title>
    <mj-preview>{{ block "preheader" .Data }}{{ end }}</mj-preview>
    <mj-raw>
      <meta name="color-scheme" content="light dark" />
      <meta name="supported-color-schemes" content="light dark" />
    </mj-raw>
    <mj-attributes>
      <mj-all
        font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif"
        font-size="16px"
        line-height="1.6"
      />
      <!-- Every text block opts into the dark-mode palette unless it names a
           more specific role (muted, section-heading, info-text). -->
      <mj-text color="#334155" css-class="dark-text" />
      <mj-class name="muted" color="#64748b" css-class="muted" />
      <mj-button
        css-class="hk-button"
        background-color="#33d399"
        color="#18181a"
        border-radius="8px"
        font-weight="700"
        font-size="14px"
        inner-padding="12px 24px"
      />
      <mj-divider border-color="#e2e8f0" border-width="1px" />
    </mj-attributes>
    <mj-style>
      :root {
        color-scheme: light dark;
        supported-color-schemes: light dark;
      }

      /* Brand green (#33d399) fails contrast on white; links use the darker
         emerald in light mode and the brand green in dark mode. */
      a {
        color: #047857;
      }

      /* Phones: give tables the width the 40px desktop gutters take away. */
      @media only screen and (max-width: 480px) {
        .card-section > table > tbody > tr > td {
          padding: 28px 20px 12px 20px !important;
        }
        .kpi-value {
          font-size: 17px !important;
        }
        .kpi-label {
          font-size: 14px !important;
        }
      }

      @media (prefers-color-scheme: dark) {
        body,
        .body-wrapper > div {
          background-color: #0f172a !important;
        }
        .card-bg > table {
          background-color: #1e293b !important;
          background: #1e293b !important;
        }
        .brand-text div,
        .dark-text div,
        .section-heading div {
          color: #f1f5f9 !important;
        }
        .footer-text div,
        .footer-social div {
          color: #94a3b8 !important;
        }
        .muted div {
          color: #94a3b8 !important;
        }
        .info-text div {
          color: #64748b !important;
        }
        .card-bg a,
        .footer-text a,
        .footer-social a,
        .info-text a {
          color: #33d399 !important;
        }
        /* Buttons keep dark text on the brand green. */
        .card-bg .hk-button a {
          color: #18181a !important;
        }
        /* Inherited table text; cells with their own inline colour (change
           indicators) are handled below. */
        .dark-table table {
          color: #e2e8f0 !important;
        }
        .dark-table .cell-label {
          color: #94a3b8 !important;
        }
        .dark-table th {
          color: #94a3b8 !important;
          border-color: #334155 !important;
        }
        .tbl-header {
          border-color: #334155 !important;
        }
        .alt-row {
          background-color: #162033 !important;
        }
        .change-up {
          color: #4ade80 !important;
        }
        .change-down {
          color: #f87171 !important;
        }
        .change-neutral {
          color: #94a3b8 !important;
        }
        .card-bg p {
          border-color: #334155 !important;
        }
      }

      /* Outlook.com dark mode rewrites colours and marks them with
         data-ogsc (text) and data-ogsb (background). */
      [data-ogsb] .body-wrapper > div {
        background-color: #0f172a !important;
      }
      [data-ogsb] .card-bg > table {
        background-color: #1e293b !important;
      }
      [data-ogsc] .brand-text div,
      [data-ogsc] .dark-text div,
      [data-ogsc] .section-heading div {
        color: #f1f5f9 !important;
      }
      [data-ogsc] .muted div,
      [data-ogsc] .footer-text div {
        color: #94a3b8 !important;
      }
      [data-ogsc] .card-bg a,
      [data-ogsc] .footer-text a,
      [data-ogsc] .footer-social a {
        color: #33d399 !important;
      }
      [data-ogsc] .card-bg .hk-button a {
        color: #18181a !important;
      }
    </mj-style>
  </mj-head>
  <mj-body css-class="body-wrapper" background-color="#f1f5f9">
    <!-- Header -->
    <mj-section padding-bottom="20px" padding-top="40px">
      <mj-column>
        <mj-text
          align="center"
          font-size="24px"
          font-weight="700"
          color="#0f172a"
          css-class="brand-text"
        >
          HitKeep
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Content Card -->
    <mj-wrapper css-class="card-bg" background-color="#ffffff" padding="0px">
      <mj-section css-class="card-section" padding="40px 40px 20px 40px">
        <mj-column>
          <!-- DYNAMIC CONTENT INJECTION -->
          {{ template "content" .Data }}
        </mj-column>
      </mj-section>
    </mj-wrapper>

    <!-- Footer -->
    <mj-section padding-top="20px" padding-bottom="40px">
      <mj-column>
        <mj-text align="center" color="#64748b" css-class="footer-text" font-size="12px">
          {{ t "footer.powered_by" }}
          <a
            href="https://hitkeep.com"
            style="color: #047857; text-decoration: none; font-weight: 600"
            >HitKeep</a
          >
          <br />
          {{ t "footer.tagline" }}
          <br />
          <a
            href="https://hitkeep.com/legal/imprint/"
            style="color: #047857; text-decoration: none; font-weight: 600"
            >{{ t "footer.imprint" }}</a
          >
          <span style="color: #94a3b8"> · </span>
          <a
            href="https://hitkeep.com/legal/privacy-policy/"
            style="color: #047857; text-decoration: none; font-weight: 600"
            >{{ t "footer.privacy_policy" }}</a
          >
        </mj-text>
        <mj-text align="center" color="#64748b" css-class="footer-social" font-size="12px" padding-top="4px">
          <span style="font-weight: 600">{{ t "footer.social.profiles" }}</span>
          <br />
          <a
            href="https://github.com/pascalebeier/hitkeep"
            style="color: #334155; text-decoration: none; font-weight: 600"
            >{{ t "footer.social.github" }}</a
          >
          <span style="color: #94a3b8">&nbsp;&nbsp;</span>
          <a
            href="https://www.linkedin.com/company/hitkeep"
            style="color: #334155; text-decoration: none; font-weight: 600"
            >{{ t "footer.social.linkedin" }}</a
          >
          <span style="color: #94a3b8">&nbsp;&nbsp;</span>
          <a
            href="https://x.com/gethitkeep"
            style="color: #334155; text-decoration: none; font-weight: 600"
            >{{ t "footer.social.x" }}</a
          >
          <span style="color: #94a3b8">&nbsp;&nbsp;</span>
          <a
            href="https://bsky.app/profile/hitkeep.com"
            style="color: #334155; text-decoration: none; font-weight: 600"
            >{{ t "footer.social.bluesky" }}</a
          >
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
