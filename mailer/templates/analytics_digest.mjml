{{ define "preheader" }}{{ .PeriodLabel }}{{ range $i, $s := .Sites }}{{ if $i }},{{ else }} ·{{ end }} {{ $s.Domain }}{{ end }}{{ end }}
{{ define "content" }}
<mj-text css-class="dark-text" font-size="20px" font-weight="600" color="#18181a" padding-bottom="4px">
  {{ tf "reports.digest_title" .FreqLabel }}
</mj-text>
<mj-text css-class="muted" color="#64748b" padding-top="0" padding-bottom="20px">
  {{ .PeriodLabel }}
</mj-text>
<mj-text css-class="muted" color="#64748b" font-size="12px" padding-top="0" padding-bottom="8px">
  {{ t "digest.change" }}: {{ t "digest.pageviews" }} · {{ t "reports.visitors" }} · {{ t "reports.goal_completions" }}
</mj-text>

<!-- One block per site: the domain on its own row keeps three metric
     columns readable on phones and in long locales. -->
<mj-table css-class="dark-table">
  {{ range $s := .Sites }}
  <tr>
    <td colspan="3" class="tbl-header" style="padding: 14px 0 6px 0; border-top: 1px solid #e2e8f0; font-size: 16px; font-weight: 600; overflow-wrap: anywhere;">
      {{ if $s.DashURL }}<a href="{{ $s.DashURL }}" style="color: #047857; text-decoration: none;">{{ $s.Domain }}</a>{{ else }}{{ $s.Domain }}{{ end }}
    </td>
  </tr>
  <tr>
    <td width="33%" style="padding: 0 8px 14px 0; vertical-align: top;">
      <div class="cell-label" style="color: #64748b; font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; -webkit-hyphens: auto; hyphens: auto;">{{ t "digest.pageviews" }}</div>
      <div style="font-size: 18px; font-weight: 700; white-space: nowrap;">{{ formatInt $s.Pageviews }}</div>
      <div class="cell-label" style="color: #64748b; font-size: 12px; font-weight: 600; white-space: nowrap;">{{ percentChange $s.Pageviews $s.PrevPageviews }}</div>
    </td>
    <td width="33%" style="padding: 0 8px 14px 0; vertical-align: top;">
      <div class="cell-label" style="color: #64748b; font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; -webkit-hyphens: auto; hyphens: auto;">{{ t "reports.visitors" }}</div>
      <div style="font-size: 18px; font-weight: 700; white-space: nowrap;">{{ formatInt $s.Visitors }}</div>
      <div class="cell-label" style="color: #64748b; font-size: 12px; font-weight: 600; white-space: nowrap;">{{ percentChange $s.Visitors $s.PrevVisitors }}</div>
    </td>
    <td width="33%" style="padding: 0 8px 14px 0; vertical-align: top;">
      <div class="cell-label" style="color: #64748b; font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; -webkit-hyphens: auto; hyphens: auto;">{{ t "reports.goal_completions" }}</div>
      <div style="font-size: 18px; font-weight: 700; white-space: nowrap;">{{ formatInt $s.Goals }}</div>
      <div class="cell-label" style="color: #64748b; font-size: 12px; font-weight: 600; white-space: nowrap;">{{ percentChange $s.Goals $s.PrevGoals }}</div>
    </td>
  </tr>
  {{ end }}
</mj-table>

{{ if .DashURL }}<mj-button href="{{ .DashURL }}" padding-top="24px" padding-bottom="8px">
  {{ t "reports.view_dashboard" }}
</mj-button>{{ end }}

<mj-divider padding-top="12px" padding-bottom="8px" />
<mj-text css-class="info-text" font-size="11px" color="#94a3b8" align="center" padding-top="0">
  {{ t "reports.received_because" }}
  {{ if .SettingsURL }}<a href="{{ .SettingsURL }}" style="color: #047857; text-decoration: none;">{{ t "reports.manage_preferences" }}</a>{{ end }}
  {{ if .UnsubscribeURL }}{{ if .SettingsURL }} · {{ end }}<a href="{{ .UnsubscribeURL }}" style="color: #047857; text-decoration: none;">{{ t "reports.unsubscribe" }}</a>{{ end }}
</mj-text>
{{ end }}
