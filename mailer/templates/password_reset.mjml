{{ define "preheader" }}{{ t "auth.password_reset.body" }}{{ end }}
{{ define "content" }}
<mj-text font-size="20px" font-weight="600" padding-bottom="10px">
  {{ t "auth.password_reset.heading" }}
</mj-text>

<mj-text> {{ t "common.hello" }} </mj-text>

<mj-text>
  {{ t "auth.password_reset.body" }}
</mj-text>

<mj-button href="{{ .Link }}" padding-top="20px" padding-bottom="20px">
  {{ t "auth.password_reset.button" }}
</mj-button>

<mj-text css-class="muted" font-size="13px" color="#64748b">
  {{ t "common.copy_link" }}
  <a href="{{ .Link }}" style="color: #047857">{{ .Link }}</a>
</mj-text>
{{ end }}
